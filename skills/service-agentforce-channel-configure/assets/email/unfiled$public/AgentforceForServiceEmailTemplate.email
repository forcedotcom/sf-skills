<!--
  HTML body for the Agentforce Service Agent email-reply template (uiType=SFX).
  This body MUST contain the two literal ASA placeholder tokens below, exactly
  as written (raw substring match) — BotEmailDefinition rejects the template
  otherwise:
    [[[GENERATED_CONTENT]]]  — where the agent's generated reply is injected.
    [[[LEGAL_DISCLOSURE]]]   — where the BotEmailDefinition legalDisclaimer is injected.
  These are literal triple-bracket tokens, NOT Salesforce merge fields; do not
  convert them to merge-field syntax. (The SFX deploy validator scans the whole
  body, including comments, and rejects any occurrence of merge-field syntax.)
-->
<html>
  <body>
    <div>[[[GENERATED_CONTENT]]]</div>
    <div>[[[LEGAL_DISCLOSURE]]]</div>
  </body>
</html>
