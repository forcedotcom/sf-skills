<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example — JWKS (uploaded keys) mode, the set that references the key in jwks_upload_key.xml.
  File: PublicKeyCertificateSet/AuthKeySet.PublicKeyCertificateSet-meta.xml
-->
<PublicKeyCertificateSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <jwtIssuer>https://auth.example.com/issuer</jwtIssuer>
    <masterLabel>AuthKeySet</masterLabel>
    <publicKeyCertificateSetKeys>
        <publicKeyCertificate>AuthKey</publicKeyCertificate>
    </publicKeyCertificateSetKeys>
    <type>JWKS</type>
</PublicKeyCertificateSet>
