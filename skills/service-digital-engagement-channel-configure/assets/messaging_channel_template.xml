<?xml version="1.0" encoding="UTF-8"?>
<MessagingChannel xmlns="http://soap.sforce.com/2006/04/metadata">
    <!-- Automated Responses (optional, repeat per response) -->
    <!-- Shape depends on type — see references/channel_settings.md "Automated Responses" -->
    <!-- TextResponse shape: OptOutConfirmation, HelpResponse only -->
    <!--
    <automatedResponses>
        <autoResponseContentType>TextResponse</autoResponseContentType>
        <language>en_US</language>
        <response>{RESPONSE_TEXT}</response>
        <type>{OptOutConfirmation|HelpResponse}</type>
    </automatedResponses>
    -->

    <!-- MessageDefinition shape: InitialResponse, AgentEngagedResponse, AgentEndEngagementResponse, EndUserInactiveResponse, EndUserIdleResponse, RerouteResponse, RoutingUnavailableResponse -->
    <!-- messageDefinitionName must reference an existing ConversationMessageDefinition (build via conversation-message-definition-builder first) -->
    <!-- Do NOT include language or response on this shape -->
    <!-- Optional responseTimeoutInMins (4-30): only for EndUserIdleResponse / EndUserInactiveResponse -->
    <!--
    <automatedResponses>
        <autoResponseContentType>MessageDefinition</autoResponseContentType>
        <messageDefinitionName>{CONVERSATION_MESSAGE_DEFINITION_DEV_NAME}</messageDefinitionName>
        <type>{InitialResponse|AgentEngagedResponse|AgentEndEngagementResponse|EndUserInactiveResponse|EndUserIdleResponse|RerouteResponse|RoutingUnavailableResponse}</type>
    </automatedResponses>
    -->

    <!-- Standard Parameters (optional, repeat per parameter) -->
    <!-- actionParameterMappings is optional — include when using Flow routing to map to flow input variables -->
    <!--
    <standardParameters>
        <actionParameterMappings>
            <actionParameterName>{FLOW_INPUT_VARIABLE_NAME}</actionParameterName>
        </actionParameterMappings>
        <parameterType>FirstName</parameterType>
    </standardParameters>
    <standardParameters>
        <parameterType>LastName</parameterType>
    </standardParameters>
    <standardParameters>
        <parameterType>Email</parameterType>
    </standardParameters>
    <standardParameters>
        <parameterType>Subject</parameterType>
    </standardParameters>
    -->

    <!-- Custom Parameters (optional, repeat per parameter) -->
    <!-- actionParameterMappings is optional — include when using Flow routing to map to flow input variables -->
    <!--
    <customParameters>
        <actionParameterMappings>
            <actionParameterName>{FLOW_INPUT_VARIABLE_NAME}</actionParameterName>
        </actionParameterMappings>
        <externalParameterName>city</externalParameterName>
        <masterLabel>City</masterLabel>
        <maxLength>50</maxLength>
        <name>city</name>
        <parameterDataType>String</parameterDataType>
    </customParameters>
    -->

    <!-- Embedded Configuration -->
    <embeddedConfig>
        <allowedFileTypes>{COMMA_SEPARATED_EXTENSIONS}</allowedFileTypes>
        <!-- Keep exactly one expiry: anonymousUserJwtExpirationTime for UnAuth (default 360), verifiedUserJwtExpirationTime for Auth (60-240) -->
        <anonymousUserJwtExpirationTime>{JWT_EXPIRATION_MINUTES}</anonymousUserJwtExpirationTime>
        <!-- <verifiedUserJwtExpirationTime>{VERIFIED_JWT_EXPIRATION_MINUTES}</verifiedUserJwtExpirationTime> -->
        <authMode>{UnAuth|Auth}</authMode>
        <chatAbandonmentTimeout>{MINUTES}</chatAbandonmentTimeout>
        <isAbandonedChatsEnabled>{true|false}</isAbandonedChatsEnabled>
        <isAttachmentUploadEnabled>{true|false}</isAttachmentUploadEnabled>
        <isEstimatedWaitTimeEnabled>{true|false}</isEstimatedWaitTimeEnabled>
        <isFallbackMessageEnabled>{true|false}</isFallbackMessageEnabled>
        <isFileAttachmentExtUnrestricted>{true|false}</isFileAttachmentExtUnrestricted>
        <isSaveTranscriptEnabled>{true|false}</isSaveTranscriptEnabled>
        <maxFileSize>{SIZE_IN_MB}</maxFileSize>

        <!-- Messaging Authorizations (only when authMode is Auth; omit entirely for UnAuth) -->
        <!--
        <messagingAuthorizations>
            <authIdentifier>{AUTH_IDENTIFIER}</authIdentifier>
            <authorizationType>PublicKeyCertificateSet</authorizationType>
            <enabled>{true|false}</enabled>
            <publicKeyCertificateSetName>{KEYSET_NAME}</publicKeyCertificateSetName>
        </messagingAuthorizations>
        -->
    </embeddedConfig>

    <!-- Session Settings -->
    <endUserIdleTimeOut>{IDLE_TIMEOUT_MINUTES}</endUserIdleTimeOut>

    <!-- Session Inactivity (optional) — top-level siblings of embeddedConfig, not nested inside it -->
    <!-- endUserIdleAction must be Inactivate, End, or InactivateAndEnd -->
    <!--
    <endUserIdleAction>{Inactivate|End|InactivateAndEnd}</endUserIdleAction>
    <endInactiveSessionTimeOut>{MINUTES_AFTER_IDLE_ACTION}</endInactiveSessionTimeOut>
    <isAgentMessageResetInactivityEnabled>{true|false}</isAgentMessageResetInactivityEnabled>
    -->

    <isEstimatedWaitTimeEnabled>{true|false}</isEstimatedWaitTimeEnabled>
    <isQueuePositionEnabled>{true|false}</isQueuePositionEnabled>
    <isSynchronousChatEnabled>{true|false}</isSynchronousChatEnabled>
    <isVoiceModeEnabled>{true|false}</isVoiceModeEnabled>
    <masterLabel>{CHANNEL_LABEL}</masterLabel>
    <messagingChannelType>EmbeddedMessaging</messagingChannelType>

    <!-- Messaging Keywords -->
    <messagingKeywords>
        <keyword>cancel</keyword>
        <keyword>end</keyword>
        <keyword>quit</keyword>
        <keyword>stop</keyword>
        <keyword>stopall</keyword>
        <keyword>unsubscribe</keyword>
        <keywordType>OptOut</keywordType>
        <language>en_US</language>
    </messagingKeywords>
    <messagingKeywords>
        <keyword>help</keyword>
        <keywordType>Help</keywordType>
        <language>en_US</language>
    </messagingKeywords>

    <!-- Routing: Queue-based -->
    <!-- <sessionHandlerQueue>{QUEUE_NAME}</sessionHandlerQueue> -->
    <!-- <sessionHandlerType>Queue</sessionHandlerType> -->

    <!-- Routing: Flow-based (requires a fallback queue) -->
    <!-- <sessionHandlerFlow>{FLOW_API_NAME}</sessionHandlerFlow> -->
    <!-- <sessionHandlerQueue>{FALLBACK_QUEUE_NAME}</sessionHandlerQueue> -->
    <!-- <sessionHandlerType>Flow</sessionHandlerType> -->

    <!-- Routing: Agentforce Service Agent (requires a fallback queue) -->
    <!-- NOTE: sessionHandlerAsa is REQUIRED at v67 — deploy fails with "Missing required Agentforce Service Agent" if omitted. -->
    <!-- The deploy binds SessionHandlerId automatically; verify it landed with a query (see SKILL.md step 15a). -->
    <!-- <sessionHandlerAsa>{ASA_BOT_DEV_NAME}</sessionHandlerAsa> -->
    <!-- <sessionHandlerQueue>{FALLBACK_QUEUE_NAME}</sessionHandlerQueue> -->
    <!-- <sessionHandlerType>AgentforceServiceAgent</sessionHandlerType> -->
</MessagingChannel>
