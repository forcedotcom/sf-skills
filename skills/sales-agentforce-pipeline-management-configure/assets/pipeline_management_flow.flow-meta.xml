    <actionCalls>
        <description>Enqueues requests to get a field update suggestion from a field generation prompt template. The invocable action also enqueues requests to update a field based on the generated suggestion, and automatically updates the field if the agent is configured to make updates autonomously.</description>
        <name>GetOrExecFieldUpdtSuggestion</name>
        <label>Get or Execute Field Update Suggestion</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>getOrExecFieldUpdtSuggestion</actionName>
        <actionType>getOrExecFieldUpdtSuggestion</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>recordId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>fieldApiNames</name>
            <value>
                <elementReference>OpportunityFields</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>agentUserId</name>
