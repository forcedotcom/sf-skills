            <value>
                <elementReference>GetSalesMgmtAgentBotRecord.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>agentBotVersionId</name>
            <value>
                <elementReference>GetSalesMgmtAgentBotVersion.Id</elementReference>
            </value>
        </inputParameters>
        <nameSegment>getOrExecFieldUpdtSuggestion</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <fullName>Process_Field_Update_Suggestions</fullName>
    <label>Process Field Update Suggestions</label>
    <assignments>
        <description>Adds the API names of the NextStep and StageName fields for the current opportunity record to the opportunityFields collection.</description>
        <name>AddOppFieldsToCollection</name>
        <label>Add Opportunity Fields to Collection</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OpportunityFields</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>NextStep</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OpportunityFields</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>StageName</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>GetAgentUserPermSetGroup</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets variables for the opportunity team member record.</description>
        <name>SetVariablesForOppTeamMemRec</name>
        <label>Set Variables for Opportunity Team Member Record</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>OppTeamMemRec.OpportunityId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OppTeamMemRec.UserId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>AgentUserId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OppTeamMemRec.OpportunityAccessLevel</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Edit</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>OppTeamMemRec.TeamMemberRole</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Sales Rep</stringValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>CreateOppTeamMemRecWithDealAgentUser</targetReference>
        </connector>
    </assignments>
    <constants>
        <description>Stores the name of the Sales Management agent template.</description>
        <name>SalesManagementAgentTemplate</name>
        <dataType>String</dataType>
        <value>
            <stringValue>SalesMgmt__SalesAgent</stringValue>
        </value>
    </constants>
    <decisions>
        <description>Determines whether an agent user is assigned to the permission set group.</description>
        <name>HaveAgentUserInPSG</name>
        <label>Have Agent User In Permission Set Group?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetAgentUserPermSet</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>HasAgentUserInPSG</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>AgentUserId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>AgentUserId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetIneligibleOppTeamMemRec</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the agent user is part of an opportunity team.</description>
        <name>IsAgentUserOnOppTeam</name>
        <label>Is Agent User on Opportunity Team?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>GetOrExecFieldUpdtSuggestion</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Yes</defaultConnectorLabel>
        <rules>
            <name>notOnOppTeam</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetIneligibleOppTeamMemRec</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SetVariablesForOppTeamMemRec</targetReference>
            </connector>
            <label>No</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines whether the opportunity CloseDate is within the next 90 days.</description>
        <name>IsOppCloseDateWithinNext90Days</name>
        <label>Is Opportunity Close Date Within Next 90 Days?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>OppCloseDateTodayOrInFuture</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CloseDate</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>$Flow.CurrentDate</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CloseDate</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>CloseDate90DaysFromToday</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AddOppFieldsToCollection</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines if the Sales Management Agent was created</description>
        <name>IsSalesManagementAgentCreated</name>
        <label>Is Sales Management Agent Created?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>SalesMgmtAgentCreated</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>GetSalesMgmtAgentBotRecord</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetSalesMgmtAgentBotVersion</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>GetSalesMgmtAgentBotVersion.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Active</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>IsOppCloseDateWithinNext90Days</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Adds the agent autonomous user as an opportunity team member to eligible opportunities and generates field update suggestions for the relevant fields on the opportunity record. Suggestions are generated based on the data sources enabled by the user, such as conversation transcripts, emails, or content notes.</description>
    <environments>Default</environments>
    <formulas>
        <description>Calculates the date that is 90 days from today&apos;s date.

(TODAY() + 90)</description>
        <name>CloseDate90DaysFromToday</name>
        <dataType>Date</dataType>
        <expression>TODAY()+90</expression>
    </formulas>
    <interviewLabel>Process Field Update Suggestions {!$Flow.CurrentDateTime}</interviewLabel>
