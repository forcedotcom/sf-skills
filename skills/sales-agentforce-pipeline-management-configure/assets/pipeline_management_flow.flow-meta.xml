    <recordLookups>
        <description>Gets the permission set assignment record with a PermissionSetID that matches the value from GetAgentUserPermSet, has an IsActive value of True, and an IsRevoked value of False. Stores the result in the AgentUserId record variable.</description>
        <name>GetAgentUserPermSetAssign</name>
