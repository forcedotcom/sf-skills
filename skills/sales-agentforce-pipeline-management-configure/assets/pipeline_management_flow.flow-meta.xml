    <recordLookups>
        <description>Gets the permission set record with an API Name equal to SalesManagementAgentAutonomousUser. Stores the result in the Permission Set from Get Agent User Permission Set record variable.</description>
        <name>GetAgentUserPermSet</name>
        <label>Get Agent User Permission Set</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>GetAgentUserPermSetAssign</targetReference>
