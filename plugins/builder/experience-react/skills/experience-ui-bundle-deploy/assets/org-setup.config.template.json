{
  "permsetAssignments": {
    "defaultAssignee": "currentUser",
    "assignments": {
      "<PermissionSetApiName>": { "assignee": "currentUser" },
      "<GuestPermissionSetApiName>": { "assignee": "guestUser" }
    }
  },
  "role": {
    "assignee": "currentUser",
    "roleName": "<UserRole name>"
  },
  "selfRegistration": {
    "selfRegProfile": "<Profile API name>",
    "accountName": "<display name>"
  },
  "socialLogin": {
    "communityMemberProfile": "<Profile name, e.g. Customer Community User>",
    "authProviderNames": ["<AuthProvider or SamlSsoConfig DeveloperName>"],
    "communityUserPermset": "<PermissionSet API name (optional)>"
  }
}
