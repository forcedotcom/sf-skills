{
  "name": "salesforce-development",
  "displayName": "Salesforce Development",
  "version": "2.4.0",
  "description": "Build Salesforce apps and agents using these core building blocks: metadata, Apex, deploy/retrieve, security, reporting, and generated installed-versus-available capability discovery.",
  "author": { "name": "Salesforce", "url": "https://github.com/forcedotcom/sf-skills" },
  "license": "Apache-2.0",
  "homepage": "https://github.com/forcedotcom/sf-skills/tree/main/plugins/builder/salesforce-development",
  "repository": "https://github.com/forcedotcom/sf-skills.git",
  "keywords": ["salesforce", "apex", "flow", "soql", "metadata", "deploy"],
  "dependencies": [],
  "userConfig": {
    "ui_mode": {
      "type": "string",
      "title": "Presentation mode",
      "description": "Ambient UI, including answers to natural-language status, orientation, and capability questions: full (default) signature banner and graded nudge, plain accessible semantic text (no color or glyphs) for status and orientation, or off (silent for all three). Slash commands and safety guidance remain available in every mode.",
      "options": ["full", "plain", "off"],
      "default": "full"
    },
    "plugin_match_sensitivity": {
      "type": "string",
      "title": "Plugin recommendation",
      "description": "How readily this plugin proposes an uninstalled Salesforce plugin matching your task: off (never), low, standard (default), or high. For a custom numeric threshold (1.0-10.0), set it from within a session with /salesforce-development:plugin-recommendations.",
      "options": ["off", "low", "standard", "high"],
      "default": "standard"
    }
  },
  "skills": "./skills/",
  "commands": "./commands/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context detect",
            "statusMessage": "Loading local Salesforce project context…"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture session_start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(sf *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context cli-update-notice"
          },
          {
            "type": "command",
            "if": "Bash(sf project deploy *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context verify-org"
          },
          {
            "type": "command",
            "if": "Bash(sf project delete *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context verify-org"
          },
          {
            "type": "command",
            "if": "Bash(sf project deploy start*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-deploy-gate prod-check"
          },
          {
            "type": "command",
            "if": "Bash(sf project deploy quick*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-deploy-gate prod-check"
          },
          {
            "type": "command",
            "if": "Bash(sf project delete*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-deploy-gate destructive"
          },
          {
            "type": "command",
            "if": "Bash(sf project deploy start*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/lsp-precheck"
          },
          {
            "type": "command",
            "if": "Bash(sf project deploy validate*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/lsp-precheck"
          },
          {
            "type": "command",
            "if": "Bash(sf apex run *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(sf project retrieve *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(sf data query *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(sf project generate manifest *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(sf project deploy *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(sf org create *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(*sf-context plugin-install * --accept-proposed*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          },
          {
            "type": "command",
            "if": "Bash(sf project generate*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context scaffold-gate"
          },
          {
            "type": "command",
            "if": "Bash(sf template generate project*)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context scaffold-gate"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context skills-first-advisory"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context record-skill-dispatch"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture skill_dispatched"
          }
        ]
      },
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture agent_dispatched"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context prompt-dispatch"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context prompt-dispatch"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context post-bash"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(force-app/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-deploy-gate auto-deploy"
          },
          {
            "type": "command",
            "if": "Write(force-app/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-deploy-gate auto-deploy"
          },
          {
            "type": "command",
            "if": "MultiEdit(force-app/**)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-deploy-gate auto-deploy"
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context resolution-trace"
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context post-ask-question"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture mcp_tool_used success"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(sf project deploy *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context post-deploy-failure"
          },
          {
            "type": "command",
            "if": "Bash(sf apex run test *)",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context post-test-failure"
          },
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture command_invoked failure"
          }
        ]
      },
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture mcp_tool_used failure"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-capture exception api_error"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context telemetry-flush"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/sf-context feedback-nudge"
          }
        ]
      }
    ]
  }
}
